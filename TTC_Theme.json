{
  "name": "TTC Red",
  "dataColors": ["#DA291C", "#A9A9A9", "#605E5C", "#F28B82", "#252423", "#C8C6C4"],
  "background": "#FFFFFF",
  "foreground": "#252423",
  "tableAccent": "#DA291C",
  "good": "#107C10",
  "neutral": "#A9A9A9",
  "bad": "#DA291C",
  "minimum": "#FBE3E1",
  "center": "#F28B82",
  "maximum": "#DA291C",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#252423" },
    "label": { "fontFace": "Segoe UI", "fontSize": 9, "color": "#605E5C" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#252423" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#252423" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F2F1" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E1DFDD" } }, "radius": 8 }],
        "visualHeader": [{ "show": false }],
        "padding": [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }]
      }
    }
  }
}
